  "arguments_positions": [
    {
      "position": "L'adhésion exige l'unanimité et peut être bloquée par la France.",
      "attribution": "Le Fil d'Actu",
      "statut": "défendu",
      "horodatages": [
        "00:03:30"
      ]
    },
    {
      "position": "L'Ukraine deviendrait un bénéficiaire majeur des fonds européens au détriment de bénéficiaires actuels.",
      "attribution": "Le Fil d'Actu",
      "statut": "défendu",
      "horodatages": [
        "00:04:12"
      ]
    },
    {
      "position": "La majorité des délocalisations françaises étudiées se fait vers d'autres pays européens.",
      "attribution": "enquête Insee citée",
      "statut": "rapporté",
      "horodatages": [
        "00:08:44"
      ]
    },
    {
      "position": "Les écarts de coûts et de normes menaceraient l'agriculture française.",
