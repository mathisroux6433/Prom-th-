      "statut": "défendu",
      "horodatages": [
        "00:10:45"
      ]
    },
    {
      "position": "La suppression des quotas rendrait les protections agricoles impossibles.",
      "attribution": "Le Fil d'Actu",
      "statut": "défendu",
      "horodatages": [
        "00:11:51"
      ]
    },
    {
